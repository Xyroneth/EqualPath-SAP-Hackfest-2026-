# EQUALPATH environment template. Copy to .env. Never commit real secrets.
# Everything is optional: with nothing set the app runs in deterministic demo mode.

# ---- AI provider: auto | sap_ai_core | openai | demo
LLM_PROVIDER=auto

# ---- SAP AI Core, generative AI hub (preferred). Either paste the whole service key JSON...
AICORE_SERVICE_KEY=
# ...or set the fields individually:
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
# orchestration (recommended) or foundation
AICORE_MODE=orchestration
AICORE_ORCHESTRATION_DEPLOYMENT_URL=
AICORE_DEPLOYMENT_ID=
AICORE_MODEL_NAME=gpt-4o-mini
AICORE_ENABLE_DPI_MASKING=false

# ---- OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Persistence: sqlite | hana
REPOSITORY=sqlite
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=EQUALPATH

# ---- Identity: local (password sign-in for staff roles) | xsuaa (SAP BTP)
IDENTITY_PROVIDER=local
# Demo passwords for the staff roles (change them for any shared deployment)
ROLE_PASSWORD_COUNSELLOR=Counsel@2026
ROLE_PASSWORD_HR_REVIEWER=HRreview@2026
ROLE_PASSWORD_AUDITOR=Audit@2026
# Signs the login tokens. If empty it is derived from the role passwords above, so set a long random value for any shared deployment.
SESSION_SECRET=

# ---- SAP Build Process Automation (final human review workflow)
SBPA_API_URL=
SBPA_TOKEN_URL=
SBPA_CLIENT_ID=
SBPA_CLIENT_SECRET=
SBPA_DEFINITION_ID=
SBPA_CALLBACK_SECRET=

# ---- Privacy: Fernet key for sensitive notes. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# ---- Demo pacing in ms (visual only; reported durations exclude it)
DEMO_STEP_DELAY_MS=450
